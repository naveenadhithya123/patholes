{
  "name": "nammafix",
  "version": "1.0.0",
  "description": "NammaFix - Smart City Road Defect Tracking & Pothole Resolution Platform for Bengaluru",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"node server/index.js\" \"npm --prefix client run dev\"",
    "build": "node build.js"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@supabase/supabase-js": "^2.118.0",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pptxgenjs": "^4.0.1",
    "uuid": "^11.1.0"
  }
}
